NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the browser. Used by the Lightspeed
# Insights webhook route to write to Supabase with RLS bypassed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string. Must match the token in the webhook URL you paste into
# the Lightspeed Insights schedule
# (https://.../api/webhooks/lightspeed-stock/<this value>).
LIGHTSPEED_WEBHOOK_SECRET=generate-a-long-random-string
